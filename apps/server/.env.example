DATABASE_URL=postgres://postgres:postgres@localhost:5432/yangi_hayot
# Bot token from @BotFather; Mini App initData is verified with it.
BOT_TOKEN=
# Shared secret apps/bot sends on /internal/bot/* (≥ 32 chars, e.g. `openssl rand -hex 32`).
BOT_API_SECRET=
# Initial settings, written only if not set yet (later changed without code):
# administrators' Telegram IDs (comma-separated) and the managers group chat id.
ADMIN_TELEGRAM_IDS=
MANAGERS_GROUP_ID=
# Where the 19:30 daily / Monday weekly report goes (comma-separated chat ids; empty = the managers group).
HISOBOT_CHAT_IDS=
# Mini App URL for web_app buttons in messages the server sends (Rassilka). Empty = nothing is sent to Telegram (dev).
MINIAPP_URL=
# Admin-panel users log in with login + password. Create the first one with
#   pnpm --filter @yh/server admin:create <login> administrator "<Ism>"
# (password from ADMIN_PASSWORD or asked); further users are added in the panel.
PORT=3000
HOST=0.0.0.0
# Bearer key for the AI-menejer katalog API (/ai/katalog/*), >= 16 chars. Unset: API disabled.
AI_API_KEY=
# Direct Mini App link from @BotFather (/newapp), e.g. https://t.me/YangiHayotBot/app.
# «Ulashish» links are built on it (?startapp=pl<id>_u<n>). Unset: sharing answers 503.
MINIAPP_LINK=
# Daily database backup (pg_dump, kept 14 days). Unset BACKUP_DIR: no backups.
BACKUP_DIR=/var/backups/yangi-hayot
# Tashkent time of the daily backup.
BACKUP_AT=03:00
# pg_dump/pg_restore of the server's major version, if not the ones on PATH.
PG_BIN_DIR=
# amoCRM (TZ 8-bo'lim). Unset AMO_BASE_URL: in-memory fake (dev), nothing goes to amoCRM.
AMO_BASE_URL=
# Long-lived token (recommended), or OAuth: AMO_CLIENT_ID, AMO_CLIENT_SECRET, AMO_REDIRECT_URI,
# AMO_REFRESH_TOKEN (+ optional AMO_ACCESS_TOKEN); refreshed tokens are kept in the database.
AMO_LONG_LIVED_TOKEN=
# Bot pipeline and its first stage (new Bitimlar go there).
AMO_PIPELINE_ID=
AMO_STATUS_ID=
# Optional: lead text field «Manba», contact text field «Telegram ID», default responsible user,
# task type ids (defaults: call/contact = 1 «Связаться», meeting = 2 «Встреча»).
AMO_MANBA_FIELD_ID=
AMO_TELEGRAM_FIELD_ID=
AMO_DEFAULT_RESPONSIBLE_ID=
AMO_TASK_TYPE_CALL=
AMO_TASK_TYPE_CONTACT=
AMO_TASK_TYPE_MEETING=

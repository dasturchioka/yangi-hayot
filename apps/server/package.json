{
  "name": "@yh/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=.env src/katalog/seed-cli.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/admin/create-admin-cli.ts",
    "import:legacy": "tsx --env-file-if-exists=.env src/kochirish/cli.ts",
    "zaxira": "tsx --env-file-if-exists=.env src/zaxira/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@yh/shared": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
